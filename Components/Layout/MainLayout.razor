@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IAlertService AlertService

<MudThemeProvider Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <!-- Top App Bar -->
    <MudAppBar Elevation="0" Dense="false" Class="ims-appbar" Style="height:64px; border-bottom: 1px solid rgba(255,255,255,0.06); background:#0D1221;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="ml-2" Spacing="1">
            <div style="width:32px;height:32px;background:linear-gradient(135deg,#3B82F6,#8B5CF6);border-radius:8px;display:flex;align-items:center;justify-content:center;">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Style="color:white;font-size:18px;" />
            </div>
            <MudText Typo="Typo.h6" Style="font-weight:700;color:#F1F5F9;letter-spacing:0.3px;">IR Command</MudText>
            <MudChip T="string" Size="Size.Small" Style="background:rgba(59,130,246,0.15);color:#3B82F6;border:1px solid rgba(59,130,246,0.3);font-size:10px;height:20px;" Class="ml-1">SOC</MudChip>
        </MudStack>
        <MudSpacer />

        <!-- System Status -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mr-3">
            <div style="width:8px;height:8px;background:#10B981;border-radius:50%;box-shadow:0 0 8px #10B981;"></div>
            <MudText Typo="Typo.caption" Style="color:#10B981;font-weight:600;">LIVE</MudText>
        </MudStack>

        <!-- Alert Bell -->
        <MudBadge Content="@_newAlertCount" Color="Color.Error" Overlap="true" Visible="@(_newAlertCount > 0)">
            <MudIconButton Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Inherit" Href="/alerts" Style="color:#94A3B8;" />
        </MudBadge>

        <!-- Dark mode toggle (static, theme is always dark) -->
        <MudIconButton Icon="@Icons.Material.Filled.DarkMode" Color="Color.Inherit" Style="color:#94A3B8;" />

        <!-- User -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="ml-2 mr-2" Style="cursor:pointer;">
            <div style="width:36px;height:36px;background:linear-gradient(135deg,#3B82F6,#8B5CF6);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                <MudText Style="color:white;font-weight:700;font-size:14px;">A</MudText>
            </div>
            <MudStack Spacing="0">
                <MudText Typo="Typo.body2" Style="font-weight:600;color:#F1F5F9;line-height:1.2;">Admin</MudText>
                <MudText Typo="Typo.caption" Style="color:#94A3B8;line-height:1.2;">Administrator</MudText>
            </MudStack>
        </MudStack>
    </MudAppBar>

    <!-- Sidebar -->
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0"
               Variant="DrawerVariant.Mini" OpenMiniOnHover="true"
               Style="background:#0D1221;border-right:1px solid rgba(255,255,255,0.06);">
        <MudNavMenu Class="mt-4 px-2">
            <!-- Main Section -->
            <MudText Typo="Typo.overline" Class="px-3 mb-1" Style="color:#475569;font-size:9px;letter-spacing:1.5px;font-weight:700;">MAIN</MudText>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" Class="nav-item">Dashboard</MudNavLink>
            <MudNavLink Href="/incidents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.BugReport" Class="nav-item">Incidents</MudNavLink>
            <MudNavLink Href="/alerts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.NotificationsActive" Class="nav-item">
                Alerts
                @if (_newAlertCount > 0)
                {
                    <MudBadge Content="@_newAlertCount" Color="Color.Error" Class="ml-auto" />
                }
            </MudNavLink>
            <MudNavLink Href="/cases" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FolderOpen" Class="nav-item">Cases</MudNavLink>

            <!-- Analysis Section -->
            <MudText Typo="Typo.overline" Class="px-3 mt-4 mb-1" Style="color:#475569;font-size:9px;letter-spacing:1.5px;font-weight:700;">ANALYSIS</MudText>
            <MudNavLink Href="/reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment" Class="nav-item">Reports</MudNavLink>

            <!-- Admin Section -->
            <MudText Typo="Typo.overline" Class="px-3 mt-4 mb-1" Style="color:#475569;font-size:9px;letter-spacing:1.5px;font-weight:700;">ADMIN</MudText>
            <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People" Class="nav-item">Users</MudNavLink>
            <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings" Class="nav-item">Settings</MudNavLink>
        </MudNavMenu>

        <MudSpacer />

        <!-- Version footer -->
        <div class="pa-3">
            <MudText Typo="Typo.caption" Style="color:#334155;font-size:10px;">IR Command v2.0</MudText>
        </div>
    </MudDrawer>

    <MudMainContent Style="background:#0B0F1A;min-height:100vh;">
        <div style="padding:24px;">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private int _newAlertCount;
    private System.Threading.Timer? _refreshTimer;

    private MudTheme _theme = new MudTheme
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#3B82F6",
            Secondary = "#8B5CF6",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Info = "#06B6D4",
            Background = "#0B0F1A",
            BackgroundGray = "#121826",
            Surface = "#121826",
            DrawerBackground = "#0D1221",
            AppbarBackground = "#0D1221",
            TextPrimary = "#F1F5F9",
            TextSecondary = "#94A3B8",
            LinesDefault = "rgba(255,255,255,0.06)",
            TableLines = "rgba(255,255,255,0.06)",
            TableHover = "rgba(59,130,246,0.08)",
            Divider = "rgba(255,255,255,0.06)",
            OverlayDark = "rgba(0,0,0,0.7)"
        },
        Typography = new Typography
        {
            Default = new Default { FontFamily = new[] { "Inter", "Roboto", "Helvetica", "Arial", "sans-serif" } },
            H1 = new H1 { FontFamily = new[] { "Poppins", "Inter", "sans-serif" }, FontWeight = 700 },
            H2 = new H2 { FontFamily = new[] { "Poppins", "Inter", "sans-serif" }, FontWeight = 700 },
            H3 = new H3 { FontFamily = new[] { "Poppins", "Inter", "sans-serif" }, FontWeight = 600 },
            H4 = new H4 { FontFamily = new[] { "Poppins", "Inter", "sans-serif" }, FontWeight = 600 },
            H5 = new H5 { FontFamily = new[] { "Poppins", "Inter", "sans-serif" }, FontWeight = 600 },
            H6 = new H6 { FontFamily = new[] { "Poppins", "Inter", "sans-serif" }, FontWeight = 600 }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        _newAlertCount = await AlertService.GetNewCountAsync();
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            _newAlertCount = await AlertService.GetNewCountAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public void Dispose() => _refreshTimer?.Dispose();

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
